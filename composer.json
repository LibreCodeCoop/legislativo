{
    "name": "librecodecoop/legislativo",
    "description": "Gestão integrada do processo legislativo municipal para Nextcloud.",
    "type": "nextcloud-app",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "LibreCode",
            "homepage": "https://librecode.coop"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-phpunit": "^1.1",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "OCA\\Legislativo\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\Legislativo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs:check": "php-cs-fixer fix --dry-run --diff --verbose",
        "cs:fix": "php-cs-fixer fix --verbose",
        "stan": "phpstan analyse --memory-limit=512M",
        "test": "phpunit --configuration phpunit.xml"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
