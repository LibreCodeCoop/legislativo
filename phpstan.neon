includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    level: 6
    paths:
        - lib/Service/MatterValidator.php
        - lib/Service/TextNormalizer.php
        - lib/Service/DeadlineCalculator.php
        - lib/Service/DeadlineStatusCalculator.php
        - lib/Service/AuditClientParser.php
        - lib/Exception/
        - tests/Unit/
    ignoreErrors:
        - '#^Method OCA\\Legislativo\\Db\\[A-Za-z]+Mapper::#'
        - '#^PHPDoc tag @return#'
    reportUnmatchedIgnoredErrors: false
